[Unit]
Description=Film Scanner Touch Screen UI
Documentation=https://github.com/yourusername/Film-Scanner
After=multi-user.target
Wants=systemd-udev-settle.service

[Service]
Type=simple
# Update User/Group to match your Pi username
User=scanner
Group=scanner

# Working directory - update path as needed
WorkingDirectory=/home/scanner/Film-Scanner

# Environment
Environment=PYTHONUNBUFFERED=1

# Direct framebuffer mode - no SDL/X11 environment needed
# The application handles framebuffer access directly
ExecStart=/usr/bin/python3 /home/scanner/Film-Scanner/touchscreen_ui.py

# Restart on failure
Restart=always
RestartSec=5
StartLimitBurst=5
StartLimitInterval=60

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=film-scanner-touchscreen

[Install]
WantedBy=multi-user.target
