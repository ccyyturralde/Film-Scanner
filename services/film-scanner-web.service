[Unit]
Description=Film Scanner Web Application
Documentation=https://github.com/yourusername/Film-Scanner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Update User/Group to match your Pi username
User=scanner
Group=scanner

# Environment
Environment=PYTHONUNBUFFERED=1

# Working directory - update path as needed
WorkingDirectory=/home/scanner/Film-Scanner

# Start the web application
ExecStart=/usr/bin/python3 /home/scanner/Film-Scanner/web_app.py

# Restart on failure
Restart=on-failure
RestartSec=5
StartLimitBurst=5
StartLimitInterval=60

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=film-scanner-web

[Install]
WantedBy=multi-user.target
