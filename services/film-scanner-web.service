# Film Scanner Web Application Service
# 
# NOTE: This is a template file. The actual service is created by setup_pi.sh
# with the correct paths and username for your system.
#
# If you need to manually install, copy this file to /etc/systemd/system/
# and update the following:
#   - User and Group (your username)
#   - WorkingDirectory (where Film-Scanner is installed)
#   - ExecStart (path to python and web_app.py)
#
# Then run:
#   sudo systemctl daemon-reload
#   sudo systemctl enable film-scanner.service

[Unit]
Description=Film Scanner Web Application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# UPDATE THESE FOR YOUR SYSTEM:
User=pi
Group=pi
WorkingDirectory=/home/pi/Film-Scanner

Environment=PYTHONUNBUFFERED=1

ExecStart=/usr/bin/python3 /home/pi/Film-Scanner/web_app.py

Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=film-scanner-web

[Install]
WantedBy=multi-user.target
