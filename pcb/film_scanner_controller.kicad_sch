    (effects (font (size 2.54 2.54)) (justify left))
  )

  (text "DC BARREL JACK INPUT (BACKUP)\n============================\n5.5x2.1mm center positive\n12V DC supply"
    (at 25.4 76.2 0)
    (effects (font (size 2.54 2.54)) (justify left))
  )

  (text "POWER OR-ING\n============\nSchottky diodes combine\nboth power sources"
    (at 127 50.8 0)
    (effects (font (size 2.54 2.54)) (justify left))
  )

  (text "5V BUCK CONVERTER\n=================\nMP2359 12V to 5V\n1.2A output"
