(kicad_pcb
  (version 20221018)
  (generator "pcbnew")
  (generator_version "7.0")
  (general
    (thickness 1.6)
    (legacy_teardrops no)
  )
  (paper "A4")
  (title_block
    (title "Film Scanner Motor Controller")
    (date "2024-12-10")
    (rev "1.0")
  )
  (layers
    (0 "F.Cu" signal)
    (31 "B.Cu" signal)
    (32 "B.Adhes" user "B.Adhesive")
    (33 "F.Adhes" user "F.Adhesive")
    (34 "B.Paste" user)
    (35 "F.Paste" user)
    (36 "B.SilkS" user "B.Silkscreen")
    (37 "F.SilkS" user "F.Silkscreen")
    (38 "B.Mask" user)
    (39 "F.Mask" user)
    (40 "Dwgs.User" user "User.Drawings")
    (41 "Cmts.User" user "User.Comments")
    (44 "Edge.Cuts" user)
  )
  (setup
    (pad_to_mask_clearance 0)
    (grid_origin 0 0)
    (pcbplotparams
      (layerselection 0x00010fc_ffffffff)
      (plot_on_all_layers_selection 0x0000000_00000000)
      (disableapertmacros no)
      (usegerberextensions yes)
      (usegerberattributes yes)
      (usegerberadvancedattributes yes)
      (creategerberjobfile yes)
      (svguseinch no)
      (svgprecision 4)
      (excludeedgelayer yes)
      (plotframeref no)
      (viasonmask no)
      (mode 1)
      (useauxorigin no)
      (hpglpennumber 1)
      (hpglpenspeed 20)
      (hpglpendiameter 15.000000)
      (dxfpolygonmode yes)
      (dxfimperialunits yes)
      (dxfusepcbnewfont yes)
      (psnegative no)
      (psa4output no)
      (plotreference yes)
      (plotvalue yes)
      (plotinvisibletext no)
      (sketchpadsonfab no)
      (subtractmaskfromsilk no)
      (outputformat 1)
      (mirror no)
      (drillshape 0)
      (scaleselection 1)
      (outputdirectory "gerbers/")
    )
  )
  (net 0 "")
  (net 1 "GND")
  (net 2 "12V_BUS")
  (net 3 "5V_BUS")
  (net 4 "VBUS_USB")
  (net 5 "12V_USB")
  (net 6 "12V_DC")
  (net 7 "CC1")
  (net 8 "CC2")
  (net 9 "STEP")
  (net 10 "DIR")
  (net 11 "ENABLE")
  (net 12 "MOTOR_1A")
  (net 13 "MOTOR_1B")
  (net 14 "MOTOR_2A")
  (net 15 "MOTOR_2B")

  ;; Board outline - 70mm x 60mm with rounded corners
  (gr_rect (start 0 0) (end 70 60) (stroke (width 0.15) (type solid)) (fill none) (layer "Edge.Cuts"))

  ;; Mounting holes - M3, 3.2mm diameter
  (footprint "MountingHole:MountingHole_3.2mm_M3" (at 5 5) (layer "F.Cu"))
  (footprint "MountingHole:MountingHole_3.2mm_M3" (at 65 5) (layer "F.Cu"))
  (footprint "MountingHole:MountingHole_3.2mm_M3" (at 5 55) (layer "F.Cu"))
  (footprint "MountingHole:MountingHole_3.2mm_M3" (at 65 55) (layer "F.Cu"))

  ;; Component placement guide (text on silkscreen)
  (gr_text "Film Scanner Controller v1.0" (at 35 3) (layer "F.SilkS")
    (effects (font (size 1.5 1.5) (thickness 0.2)) (justify center)))

  (gr_text "USB-C" (at 10 15) (layer "F.SilkS")
    (effects (font (size 1 1) (thickness 0.15)) (justify center)))

  (gr_text "DC 12V" (at 10 35) (layer "F.SilkS")
    (effects (font (size 1 1) (thickness 0.15)) (justify center)))

  (gr_text "A4988" (at 35 30) (layer "F.SilkS")
    (effects (font (size 1.2 1.2) (thickness 0.15)) (justify center)))

  (gr_text "MOTOR" (at 60 30) (layer "F.SilkS")
    (effects (font (size 1 1) (thickness 0.15)) (justify center)))

  (gr_text "ARDUINO" (at 60 50) (layer "F.SilkS")
    (effects (font (size 1 1) (thickness 0.15)) (justify center)))

  (gr_text "5V OUT" (at 35 50) (layer "F.SilkS")
    (effects (font (size 1 1) (thickness 0.15)) (justify center)))

)

